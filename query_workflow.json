        "jsCode": "const chunks = items.map(item => {\n  const source = item.json.document.metadata.doc_name || 'unknown document';\n  const text = item.json.document.pageContent;\n  return `[Source: ${source}]\\n${text}`;\n});\nconst context = chunks.join('\\n\\n---\\n\\n');\n\nconst question = $('When chat message received').first().json.chatInput;\n\nreturn [{\n  json: {\n    context: context,\n    question: question,\n  }\n}];"
