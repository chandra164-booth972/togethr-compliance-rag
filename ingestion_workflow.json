    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text || '';\n\n// Strip the repeated page footer, e.g. \"Togethr Clinical & Compliance — TG-POL-03\" and \"Page 1\"\nlet cleaned = raw.replace(/Togethr Clinical & Compliance\\s*—\\s*TG-POL-\\d+/g, '');\ncleaned = cleaned.replace(/Page\\s*\\d+/g, '');\n\n// Collapse extra whitespace/line breaks into single spaces\ncleaned = cleaned.replace(/\\s+/g, ' ').trim();\n\n// Keep track of which file this came from, for citations later\nconst fileName = $('Search files and folders').item.json.name || 'unknown.pdf';\n\nreturn {\n  json: {\n    doc_name: fileName,\n    text: cleaned,\n  }\n};"
      },
